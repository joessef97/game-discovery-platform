# MongoDB Connection
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/game-discovery?retryWrites=true&w=majority&appName=YourCluster

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-here

# Twitch IGDB API Credentials
# Get these from: https://dev.twitch.tv/console
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret

# Server Port
PORT=5000

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:3000

# Resend Email Service
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
# Must be a verified domain in Resend (or use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=onboarding@resend.dev
